{
  "name": "handlebars-a-la-json",
  "version": "3.0.0",
  "description": "Handlebars is great for generating HTML. Let's use it to generate JSON!",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "npm run build && node --test",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm test",
    "postpublish": "git push origin --tags",
    "publish-patch": "npm test && npm version patch && npm publish",
    "publish-minor": "npm test && npm version minor && npm publish",
    "publish-major": "npm test && npm version major && npm publish",
    "format": "prettier --config .prettierrc {test,src}/**/*.ts --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeesCBakker/handlebars-a-la-json.git"
  },
  "keywords": [
    "handlebars",
    "JSON",
    "templates"
  ],
  "author": "Kees C. Bakker (https://keestalkstech.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/KeesCBakker/handlebars-a-la-json/issues"
  },
  "homepage": "https://github.com/KeesCBakker/handlebars-a-la-json#readme",
  "devDependencies": {
    "@types/node": "^26",
    "prettier": "^3.9",
    "typescript": "^7"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-error-message-for-json-parse": "^0.1.6",
    "decache": "^4.6.2",
    "handlebars": "^4"
  },
  "files": [
    "dist"
  ]
}
